---
const LINKS = [
	{ href: '#home', label: 'Home' },
	{ href: '#features', label: 'Features' },
	{ href: '#articles', label: 'Articles' },
];

const SOCIAL = [
	{ icon: '/images/facebook.png', label: 'Facebook' },
	{ icon: '/images/youtube.png', label: 'YouTube' },
	{ icon: '/images/instagram.png', label: 'Instagram' },
	{ icon: '/images/twitter.png', label: 'Twitter' },
];
---

<footer class="w-full bg-[#2d314d] px-6 py-16">
	<div class="mx-auto grid max-w-7xl grid-cols-1 items-center gap-10 text-center xl:grid-cols-3">

		<div class="flex flex-col items-center gap-6">
			<img src="/images/logo-light.svg" alt="Digitalbank" width="160">
			<div class="flex items-center gap-5">
				{SOCIAL.map(({ icon, label }) => (
					<a href="#" aria-label={label} class="cursor-pointer transition hover:brightness-200">
						<img src={icon} alt="" width="20">
					</a>
				))}
			</div>
		</div>

		<nav aria-label="Footer" class="flex flex-wrap items-center justify-center gap-x-8 gap-y-3 text-[15px] text-white">
			{LINKS.map(({ href, label }) => (
				<a href={href} class="transition-colors hover:text-emerald-400">{label}</a>
			))}
		</nav>

		<div class="flex flex-col items-center gap-5">
			<button type="button" class="btn-invite">Request Invite</button>
			<span class="text-sm text-[#7e7e7e]">© Digitalbank. All Rights Reserved</span>
		</div>
	</div>
</footer>
