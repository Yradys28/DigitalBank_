---
const FEATURES = [
	{
		icon: '/images/icon-online.svg',
		title: 'Online Banking',
		description: 'Our modern web and mobile applications allow you to keep track of your finances wherever you are in the world.',
	},
	{
		icon: '/images/icon-budgeting.svg',
		title: 'Simple Budgeting',
		description: 'See exactly where your money goes each month. Receive notifications when you’re close to hitting your limits.',
	},
	{
		icon: '/images/icon-onboarding.svg',
		title: 'Fast Onboarding',
		description: 'We don’t do branches. Open your account in minutes online and start taking control of your finances right away.',
	},
	{
		icon: '/images/icon-api.svg',
		title: 'Open API',
		description: 'Manage your savings, investments, pension, and much more from one account. Tracking your money has never been easier.',
	},
];

const ARTICLES = [
	{
		image: '/images/image-currency.jpg',
		alt: 'Banknotes from different currencies',
		author: 'Claire Robinson',
		title: 'Receive money in any currency with no fees',
		excerpt: 'The world is getting smaller and we’re becoming more mobile. So why should you be forced to only receive money in a single …',
		readTime: '4 min read',
	},
	{
		image: '/images/image-restaurant.jpg',
		alt: 'Restaurant table set for a meal',
		author: 'Wilson Hutton',
		title: 'Treat yourself without worrying about money',
		excerpt: 'Our simple budgeting feature allows you to separate out your spending and set realistic limits each month. That means you …',
		readTime: '3 min read',
	},
	{
		image: '/images/image-plane.jpg',
		alt: 'Airplane flying over a city',
		author: 'Wilson Hutton',
		title: 'Take your Digitalbank card wherever you go',
		excerpt: 'We want you to enjoy your travels. This is why we don’t charge any fees on purchases while you’re abroad. We’ll even…',
		readTime: '5 min read',
	},
	{
		image: '/images/image-confetti.jpg',
		alt: 'Confetti celebration',
		author: 'Claire Robinson',
		title: 'Our invite-only Beta accounts are now live!',
		excerpt: 'After a lot of hard work by the whole team, we’re excited to launch our closed beta. It’s easy to request an invite through the site ...',
		readTime: '2 min read',
	},
];
---

<main class="w-full">
	<section id="features" class="w-full bg-[#f1f1f180] px-6 py-16 xl:py-24">
		<div class="mx-auto max-w-7xl">
			<div class="flex flex-col items-center gap-4 text-center">
				<h2 class="text-balance text-[35px] leading-tight text-[#2d314d] xl:text-[43px]">Why choose DigitalBank?</h2>
				<span class="h-1 w-16 rounded-full bg-linear-to-bl from-[hsl(136,64%,51%)] to-[hsl(192,69%,51%)]" aria-hidden="true"></span>
				<p class="max-w-2xl leading-5 text-[#8a8484] xl:text-[20px] xl:leading-7">We leverage Open Banking to turn your bank account into your financial hub. Control your finances like never before.</p>
			</div>

			<ul class="mt-10 grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4">
				{FEATURES.map(({ icon, title, description }) => (
					<li class="group flex flex-col items-center gap-4 rounded-xl border border-transparent bg-white/0 p-6 text-center transition-all duration-300 ease-out hover:-translate-y-1.5 hover:border-white hover:bg-white/70 hover:shadow-[0_12px_28px_rgba(45,49,77,0.14)] xl:gap-6 xl:p-7">
						<img src={icon} alt="" width="90" class="transition-transform duration-300 ease-out group-hover:-translate-y-1 group-hover:scale-105">
						<h3 class="text-balance text-[30px] leading-tight text-[#2d314d]">{title}</h3>
						<p class="leading-5 text-[#8a8484] xl:text-[20px] xl:leading-7">{description}</p>
					</li>
				))}
			</ul>
		</div>
	</section>

	<section id="articles" class="w-full px-6 py-16 xl:py-24">
		<div class="mx-auto max-w-7xl">
			<div class="flex flex-col items-center gap-4">
				<h2 class="text-center text-[35px] leading-tight text-[#2d314d] xl:text-[43px]">Latest Articles</h2>
				<span class="h-1 w-16 rounded-full bg-linear-to-bl from-[hsl(136,64%,51%)] to-[hsl(192,69%,51%)]" aria-hidden="true"></span>
			</div>

			<ul class="mt-10 grid grid-cols-1 gap-8 sm:grid-cols-2 xl:grid-cols-4">
				{ARTICLES.map(({ image, alt, author, title, excerpt, readTime }) => (
					<li class="group flex h-full cursor-pointer flex-col overflow-hidden rounded-lg bg-white shadow-sm transition-all duration-300 ease-out hover:-translate-y-1.5 hover:shadow-[0_16px_32px_rgba(45,49,77,0.18)]">
						<div class="relative overflow-hidden">
							<img src={image} alt={alt} class="aspect-[3/2] w-full object-cover transition-transform duration-300 ease-out group-hover:scale-105">
							<span class="absolute top-3 left-3 rounded-full bg-white/95 px-3 py-1 text-[12px] font-medium text-[#2d314d] shadow-sm backdrop-blur-sm">{readTime}</span>
						</div>
						<div class="flex flex-1 flex-col items-center gap-3 p-6 text-center">
							<span class="text-[13px] text-[#525252] transition-colors duration-300 group-hover:text-[hsl(136,64%,51%)]">By {author}</span>
							<h3 class="text-balance text-[17px] font-medium text-[#15182c] transition-colors duration-300 group-hover:text-[hsl(136,64%,51%)]">{title}</h3>
							<p class="text-[15px] text-[#6e6a6a]">{excerpt}</p>
						</div>
					</li>
				))}
			</ul>
		</div>
	</section>
</main>
